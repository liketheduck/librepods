<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Noise Cancellation -->
    <shortcut
        android:shortcutId="noise_cancellation_on"
        android:shortcutShortLabel="@string/shortcut_anc_on"
        android:enabled="true">
        <intent
            android:action="com.openpods.app.ACTION_NOISE_CONTROL"
            android:targetPackage="com.openpods.app"
            android:targetClass="com.openpods.app.VoiceCommandActivity">
            <extra android:name="mode" android:value="noise_cancellation" />
        </intent>
        <capability-binding android:key="actions.intent.TOGGLE_ON">
            <parameter-binding
                android:key="targetDevice.name"
                android:value="@array/noise_cancellation_synonyms" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="noise_cancellation_off"
        android:shortcutShortLabel="@string/shortcut_anc_off"
        android:enabled="true">
        <intent
            android:action="com.openpods.app.ACTION_NOISE_CONTROL"
            android:targetPackage="com.openpods.app"
            android:targetClass="com.openpods.app.VoiceCommandActivity">
            <extra android:name="mode" android:value="off" />
        </intent>
        <capability-binding android:key="actions.intent.TOGGLE_OFF">
            <parameter-binding
                android:key="targetDevice.name"
                android:value="@array/noise_cancellation_synonyms" />
        </capability-binding>
    </shortcut>

