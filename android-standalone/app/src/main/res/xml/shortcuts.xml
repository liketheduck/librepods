    <shortcut
        android:shortcutId="adaptive_on"
        android:shortcutShortLabel="@string/shortcut_adaptive_on"
        android:enabled="true">
        <intent
            android:action="com.openpods.app.ACTION_NOISE_CONTROL"
            android:targetPackage="com.openpods.app"
            android:targetClass="com.openpods.app.VoiceCommandActivity">
            <extra android:name="mode" android:value="adaptive" />
